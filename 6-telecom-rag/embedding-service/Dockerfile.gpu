FROM pytorch/pytorch:2.14.1-cuda12.6-cudnn9-runtime

COPY --from=ghcr.io/astral-sh/uv:0.6.14 /uv /usr/local/bin/uv

WORKDIR /app

ENV HF_HOME=/models \
    HF_HUB_DISABLE_SSL_VERIFICATION=1 \
    HF_HUB_DISABLE_XET=1 \
    UV_LINK_MODE=copy \
    UV_BREAK_SYSTEM_PACKAGES=1 \
    UV_HTTP_TIMEOUT=120 \
    UV_SYSTEM_CERTS=true \
    UV_INSECURE_HOST="pypi.org files.pythonhosted.org pypi.python.org download.pytorch.org download-r2.pytorch.org" \
    DEVICE=cuda \
    PATH="/app/.venv/bin:$PATH"

COPY download_model.py ./

RUN uv pip install --system huggingface_hub && \
    python download_model.py

COPY pyproject.toml uv.lock ./

RUN --mount=type=cache,target=/root/.cache/uv \
    uv venv --system-site-packages .venv && \
    uv sync --frozen --no-dev --no-install-project --no-install-package torch

COPY . .

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8001"]
